POSTGRES_DB=widget_platform
POSTGRES_USER=widget_user
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql://widget_user:change-me-locally@db:5432/widget_platform
PUBLIC_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=*
MAX_PAYLOAD_BYTES=16384
RATE_LIMIT_IP=20
RATE_LIMIT_WIDGET=100
RATE_LIMIT_WINDOW_SECONDS=60
GEO_PROVIDER_A_URL=http://ip-api.com/json/{ip}?fields=status,country,countryCode,city
GEO_PROVIDER_B_URL=https://ipapi.co/{ip}/json/
GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true
GEO_TIMEOUT_SECONDS=1.5
WORKER_ENABLED=true
WORKER_POLL_SECONDS=2
NOTIFICATION_FORCE_FAILURE=false
TRUST_PROXY_HEADERS=false
DEMO_TENANT_A_API_KEY=replace-with-a-long-random-key
DEMO_TENANT_B_API_KEY=replace-with-another-long-random-key
AI_MONTHLY_BUDGET_USD=0
